# NOTE: В мобильное приложение попадут только публичные настройки.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# WARNING: URL выше подходит компьютеру; на телефоне нужен отдельный адрес локального окружения.
# NOTE: service_role, пароль PostgreSQL и секреты никогда не получают префикс EXPO_PUBLIC_.
HABITZEN_LOG_TIME_ZONE=Europe/Warsaw
HABITZEN_LOG_RETENTION_DAYS=14

