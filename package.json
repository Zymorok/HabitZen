{
  "name": "habitzen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Основа HabitZen: мобильное приложение, PostgreSQL, правила продукта и инструменты разработки.",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @habitzen/mobile",
    "lint": "eslint packages tests scripts apps/mobile/src --no-warn-ignored",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:architecture",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:verify": "node scripts/verify-database.mjs",
    "logs:demo": "node scripts/log-demo.mts",
    "start": "npm run start --workspace @habitzen/mobile --",
    "web": "npm run web --workspace @habitzen/mobile --",
    "preview:web": "node scripts/serve-web.mjs --port 8098",
    "export:web": "npm run export:web --workspace @habitzen/mobile --"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
